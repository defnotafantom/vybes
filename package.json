{
  "name": "vybes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && prisma migrate deploy && next build",
    "build:e2e": "next build",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "demo:popola": "tsx scripts/demo-dati.ts",
    "db:studio": "prisma studio",
    "db:verifica": "node scripts/verifica-connessioni.mjs",
    "dev": "next dev",
    "dev:demo": "node scripts/dev-demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "artisti:importa": "tsx scripts/importa-artisti.ts",
    "pulisci:e2e": "tsx scripts/pulisci-e2e.ts",
    "reputazione:ricalcola": "tsx scripts/ricalcola-reputazione.ts",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/verifica-db-test.mjs && playwright test",
    "test:e2e:setup": "playwright install --with-deps chromium webkit",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "user:admin": "tsx scripts/assegna-ruolo-admin.ts",
    "user:crea": "tsx scripts/crea-utente.ts",
    "user:elenco": "tsx scripts/elenca-utenti.ts",
    "user:elimina": "tsx scripts/elimina-account.ts",
    "user:password": "tsx scripts/reimposta-password.ts",
    "user:slug": "tsx scripts/cambia-slug.ts",
    "verify": "npm run typecheck && npm run lint && npm run verify:seo && npm test",
    "verify:seo": "node scripts/verifica-canonical.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@sentry/nextjs": "^10.69.0",
    "@vercel/analytics": "^1.4.1",
    "@vercel/blob": "^0.27.0",
    "@vercel/speed-insights": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "slugify": "^1.6.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
