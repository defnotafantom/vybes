// Vybes - schema dati. postgresql su Neon.
//
// DATABASE_URL punta al pooler (host con "-pooler"): e' la connessione usata
// a runtime dalle funzioni serverless, che aprono e chiudono connessioni di
// continuo.
// DIRECT_URL punta all'endpoint diretto (stesso host senza "-pooler"): serve
// a `prisma migrate`, che ha bisogno di una sessione stabile e di prendere
// lock sullo schema, cosa che il pooler in transaction mode non consente.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- UTENTI

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          String    @default("ARTIST") // ARTIST | RECRUITER
  // Asse separato dal ruolo di prodotto: vedi src/lib/permissions.ts
  adminRole     String    @default("NONE") // NONE | MODERATOR | ADMIN | SUPERADMIN

  name     String
  slug     String  @unique // usato nelle URL pubbliche: /artisti/[slug]
  bio      String?
  headline String? // usato come meta description del profilo
  image    String?
  cover    String?
  website  String?
  instagram String?
  spotify   String?
  youtube   String?

  // Discipline artistiche, stringa separata da virgole (portabile su sqlite)
  disciplines String @default("")

  // Localizzazione: alimenta le pagine directory /[citta]/artisti
  citySlug  String?
  city      String?
  region    String?
  country   String  @default("IT")
  latitude  Float?
  longitude Float?

  // Visibilita': solo i profili pubblici finiscono in sitemap e indice
  isPublic   Boolean @default(true)
  isVerified Boolean @default(false)

  // Gamification
  level      Int @default(1)
  experience Int @default(0)
  reputation Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts          Post[]
  portfolioItems PortfolioItem[]
  eventsCreated  Event[]         @relation("EventOrganizer")
  participations Participation[]
  comments       Comment[]
  likes          Like[]
  saves          SavedPost[]
  questProgress  QuestProgress[]
  notifications  Notification[]  @relation("NotificationRecipient")
  actorNotifs    Notification[]  @relation("NotificationActor")
  sentMessages   Message[]       @relation("MessageSender")
  conversations  ConversationParticipant[]
  followers      Follow[]        @relation("Following")
  following      Follow[]        @relation("Follower")
  tokens         VerificationToken[]
  reportsInviati Report[]        @relation("SegnalazioniInviate")
  reportsDecisi  Report[]        @relation("SegnalazioniDecise")

  // Copre la query principale della directory locale:
  // "artisti pubblici di <citta>, ordinati per reputazione".
  @@index([citySlug, role, isPublic, reputation])
  @@index([role, isPublic, reputation])
  @@index([updatedAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  type      String   @default("EMAIL_VERIFY") // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ---------------------------------------------------------------- CITTA'

// Tabella dedicata: ogni riga genera una landing SEO statica.
model City {
  id       String @id @default(cuid())
  slug     String @unique // "milano"
  name     String // "Milano"
  region   String // "Lombardia"
  country  String @default("IT")
  latitude Float
  longitude Float
  population Int   @default(0)
  // Testo introduttivo unico per la landing: evita il thin content
  intro    String @default("")

  @@index([region])
}

// ---------------------------------------------------------------- POST

model Post {
  id        String  @id @default(cuid())
  authorId  String
  type      String  @default("STANDARD") // STANDARD | COLLABORATION | ANNOUNCEMENT
  content   String
  mediaUrl  String?
  mediaType String? // image | video | audio

  // Tag normalizzati come record dedicati (filtrabili con un indice reale)
  tags PostTag[]

  // Collaborazioni: id utenti invitati, separati da virgola
  collaborationArtists String @default("")

  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  saves    SavedPost[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  label String
  posts PostTag[]

  @@index([label])
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Like {
  id     String @id @default(cuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model SavedPost {
  id     String @id @default(cuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- EVENTI

model Event {
  id          String  @id @default(cuid())
  slug        String  @unique // /eventi/[slug]
  organizerId String
  title       String
  description String
  coverImage  String?

  category String @default("LIVE") // LIVE | CASTING | WORKSHOP | CONTEST | JAM

  startsAt DateTime
  endsAt   DateTime?

  venueName String?
  address   String?
  citySlug  String
  city      String
  region    String?
  country   String @default("IT")
  latitude  Float
  longitude Float

  // Compenso: alimenta anche lo Schema.org Offer
  isPaid    Boolean @default(false)
  feeMin    Int?
  feeMax    Int?
  currency  String  @default("EUR")

  capacity Int?
  status   String  @default("PUBLISHED") // DRAFT | PUBLISHED | CANCELLED | COMPLETED
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizer      User            @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participations Participation[]

  // Copre "ingaggi pubblicati a <citta> da oggi in poi", la query piu' calda.
  @@index([citySlug, status, isPublic, startsAt])
  @@index([status, isPublic, startsAt])
  @@index([category, status, startsAt])
  @@index([organizerId, startsAt])
}

model Participation {
  id      String @id @default(cuid())
  eventId String
  userId  String
  status  String @default("PENDING") // PENDING | ACCEPTED | REJECTED | CANCELLED
  message String?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status])
}

// ---------------------------------------------------------------- PORTFOLIO

model PortfolioItem {
  id      String @id @default(cuid())
  userId  String
  slug    String @unique // /portfolio/[slug]
  title   String
  description String?
  mediaUrl    String
  mediaType   String  @default("image") // image | video | audio
  thumbnail   String?
  externalUrl String?
  year        Int?
  position    Int     @default(0)
  isPublic    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([isPublic, updatedAt])
}

// ---------------------------------------------------------------- QUEST

model Quest {
  id          String @id @default(cuid())
  key         String @unique // first_post | profile_complete | ...
  title       String
  description String
  icon        String @default("star")
  xpReward    Int    @default(50)
  repReward   Int    @default(0)
  target      Int    @default(1)
  category    String @default("ONBOARDING")

  progress QuestProgress[]
}

model QuestProgress {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  current     Int       @default(0)
  completedAt DateTime?

  /// Quando la ricompensa e' stata riscossa.
  ///
  /// Completare e riscuotere sono due momenti distinti, di proposito.
  /// L'XP arrivava da solo nel momento in cui la condizione era soddisfatta:
  /// funzionava, ma non se ne accorgeva nessuno — il numero cambiava mentre
  /// si stava facendo altro, e la pagina Quest diventava un archivio di cose
  /// gia' successe. Separare i due momenti restituisce a chi fa la fatica il
  /// momento in cui la incassa, ed e' anche cio' che permette all'elenco di
  /// liberarsi: una quest riscossa esce di scena.
  ///
  /// Nullo finche' non e' riscossa. Le quest completate prima di questa
  /// migrazione vengono marcate come gia' riscosse: l'XP l'avevano gia'
  /// ricevuto, e lasciarle riscuotibili l'avrebbe raddoppiato.
  riscossaIl  DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
}

// ---------------------------------------------------------------- CHAT

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  mediaUrl       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------- NOTIFICHE

model Notification {
  id          String  @id @default(cuid())
  recipientId String
  actorId     String?
  type        String  // FOLLOW | LIKE | COMMENT | MESSAGE | EVENT_REQUEST | EVENT_ACCEPTED | EVENT_REJECTED | QUEST_COMPLETED
  entityId    String?
  entityUrl   String?
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt])
}

// ------------------------------------------------------------ SEGNALAZIONI

/// Segnalazione di un contenuto.
///
/// Il Digital Services Act impone a chi ospita contenuti caricati dagli utenti
/// un meccanismo di "notice and action": chiunque deve poter segnalare un
/// contenuto illecito, e chi segnala ha diritto a un riscontro sulla decisione.
/// L'obbligo non e' proporzionato alla dimensione della piattaforma.
///
/// `reporterId` e' opzionale perche' la segnalazione deve essere possibile
/// anche senza account: la norma non la riserva agli iscritti, e chi si imbatte
/// in un contenuto illecito arrivando da una ricerca non ha motivo di
/// registrarsi per segnalarlo.
///
/// L'oggetto segnalato e' identificato da tipo + id invece che da una relazione
/// per ciascun tipo. La scelta e' discussa in ADR-019: in sintesi, cinque
/// chiavi esterne nullable renderebbero impossibile esprimere nello schema il
/// vincolo "esattamente una valorizzata", e la relazione servirebbe solo a fare
/// join che qui non servono mai.
model Report {
  id         String  @id @default(cuid())
  targetType String  // USER | POST | PORTFOLIO | EVENT | COMMENT
  targetId   String
  /// URL pubblico del contenuto al momento della segnalazione: se poi viene
  /// rimosso, resta comunque traccia di cosa si stava guardando.
  targetUrl  String?

  reason  String  // ILLEGALE | ODIO | MOLESTIE | SPAM | SESSUALE | MINORI | PROPRIETA_INTELLETTUALE | IMPERSONAZIONE | ALTRO
  details String?

  reporterId    String?
  /// Serve a dare riscontro a chi segnala senza essere iscritto.
  reporterEmail String?

  status     String    @default("APERTA") // APERTA | IN_ESAME | ACCOLTA | RESPINTA
  /// Motivazione della decisione, dovuta a chi ha segnalato e a chi ha subito
  /// la rimozione. Una moderazione che non spiega non e' verificabile.
  decisione  String?
  decisaDaId String?
  decisaIl   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter User? @relation("SegnalazioniInviate", fields: [reporterId], references: [id], onDelete: SetNull)
  decisaDa User? @relation("SegnalazioniDecise", fields: [decisaDaId], references: [id], onDelete: SetNull)

  /// La coda si apre sempre sulle aperte, in ordine di arrivo.
  @@index([status, createdAt])
  /// Per contare quante segnalazioni pesano su uno stesso contenuto.
  @@index([targetType, targetId])
}
