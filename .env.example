# URL pubblico canonico del sito (senza slash finale) - usato per canonical, sitemap, OG
NEXT_PUBLIC_SITE_URL="https://vybes.it"
DATABASE_URL="file:./dev.db"
AUTH_SECRET="cambia-questo-con-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
# Storage upload: "local" | "s3" | "cloudinary"
UPLOAD_DRIVER="local"

# ── Moderazione automatica delle immagini ──────────────────────────────────
#
# Facoltative, ma consigliate con le registrazioni aperte: senza, chiunque può
# caricare qualsiasi cosa su un dominio indicizzato. Se mancano, i caricamenti
# passano e `/api/health` riporta `moderazioneImmagini: false`.
#
# Piano gratuito su sightengine.com, poi Dashboard → API credentials.
SIGHTENGINE_USER=""
SIGHTENGINE_SECRET=""

# ── Accesso con Google ────────────────────────────────────────────────────
#
# Facoltative: senza queste due il provider non viene nemmeno registrato, e il
# pulsante «Continua con Google» non compare su /accedi e /registrati. Con
# entrambe compare da solo — non c'è niente da attivare nel codice.
#
# console.cloud.google.com → API e servizi → Credenziali → ID client OAuth,
# tipo «Applicazione web». Fra gli URI di reindirizzamento autorizzati servono
# **entrambi**, altrimenti funziona in produzione e non in locale (o
# viceversa, che è peggio perché lo si scopre dopo il deploy):
#
#     https://vybeshub.art/api/auth/callback/google
#     http://localhost:3000/api/auth/callback/google
#
# Su Vercel il segreto va marcato Sensitive. Qui restano vuote: questo file è
# l'unico dei quattro `.env*` che git tiene, ed è un modello, non un archivio.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
