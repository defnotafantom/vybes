# Sviluppo locale. Copia in .env.local
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opzione A — branch di sviluppo su Neon (consigliata: stesso motore della produzione)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Opzione B — Postgres in Docker
# docker run --name vybes-db -e POSTGRES_PASSWORD=vybes -e POSTGRES_DB=vybes -p 5432:5432 -d postgres:16
# DATABASE_URL="postgresql://postgres:vybes@localhost:5432/vybes"
# DIRECT_URL="postgresql://postgres:vybes@localhost:5432/vybes"

AUTH_SECRET="secret-solo-per-sviluppo-locale"
AUTH_TRUST_HOST="true"

# In locale i file finiscono in public/uploads
UPLOAD_DRIVER="local"

